{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ObjectOS",
  "version": "0.0.0",
  "identifier": "ai.objectstack.objectos",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ObjectOS",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../runtime/*": "runtime/",
      "../runtime/**/*": "runtime/"
    },
    "category": "DeveloperTool",
    "shortDescription": "ObjectOS local runtime",
    "longDescription": "Run an ObjectStack environment locally. Bundles a Node runtime, the @objectos/app server and a compiled artifact."
  }
}
