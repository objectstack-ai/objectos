{
  "name": "objectos-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check --continue",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:dev": "turbo run dev --filter=@objectos/docs",
    "docs:build": "turbo run build --filter=@objectos/docs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
